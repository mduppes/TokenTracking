{
  "manifest_version": 3,
  "name": "TokenTracking",
  "version": "0.4.0",
  "description": "Reads your AI subscription usage (Claude, Cursor incl. Grok Bot, Gemini, Muse) and sends it to your local TokenTracking service.",
  "permissions": [
    "storage",
    "alarms",
    "offscreen",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "http://127.0.0.1:7878/*",
    "http://localhost:7878/*",
    "https://claude.ai/*",
    "https://cursor.com/*",
    "https://www.cursor.com/*",
    "https://gemini.google.com/*",
    "https://muse.ai/*",
    "https://www.muse.ai/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://cursor.com/*",
        "https://www.cursor.com/*",
        "https://gemini.google.com/*",
        "https://muse.ai/*",
        "https://www.muse.ai/*"
      ],
      "js": [
        "content/hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://claude.ai/*",
        "https://cursor.com/*",
        "https://www.cursor.com/*",
        "https://gemini.google.com/*",
        "https://muse.ai/*",
        "https://www.muse.ai/*"
      ],
      "js": [
        "content/collector.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "TokenTracking"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
